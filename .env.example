# Copy to .env (gitignored) and fill in the password.
#
# Local dev machine: finview_dev on the VPS, reached through the
# finview-dev-db-tunnel user service (local 127.0.0.1:55435 -> VPS 5432).
DATABASE_URL=postgresql+psycopg://finview_dev:CHANGE_ME@127.0.0.1:55435/finview_dev

# VPS (production): connect directly on the VPS's main cluster.
# DATABASE_URL=postgresql+psycopg://finview_prod:CHANGE_ME@127.0.0.1:5432/finview_prod
# DEV_DATABASE_URL=postgresql+psycopg://finview_dev:CHANGE_ME@127.0.0.1:5432/finview_dev
